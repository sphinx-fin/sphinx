{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SuitabilityMismatch",
  "description": "F-DET-002: 투자성향 설문 기재와 실제 발화의 모순. 세션 단위 판정. 근거 없는 판정은 무효 (P4). ※ 초안 — contracts/ 반영 전",
  "type": "object",
  "required": [
    "session_id",
    "status",
    "mismatch",
    "confidence",
    "contradictions",
    "reason"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "evaluated",
        "insufficient_input"
      ],
      "description": "insufficient_input은 판정하지 못한 것이며 '적합'이 아니다. 실패를 은폐하지 않는다 (E-EXT-03과 동일 원칙)"
    },
    "mismatch": {
      "type": "boolean",
      "description": "gate_rules.yaml R-02의 suitabilityMismatch로 들어간다. status=insufficient_input이면 항상 false이며, 그 false를 적합으로 읽으면 안 된다"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "확인된 모순 중 최고 확신도"
    },
    "contradictions": {
      "type": "array",
      "description": "mismatch=true이면 최소 1건이어야 한다 (P4)",
      "items": {
        "$ref": "#/$defs/contradiction"
      }
    },
    "reason": {
      "type": "string",
      "description": "판정 사유 1문장"
    },
    "survey_schema_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "어떤 설문 스키마로 판정했는지. 설문 문항이 바뀌면 과거 판정의 근거를 추적해야 한다"
    }
  },
  "$defs": {
    "contradiction": {
      "type": "object",
      "required": [
        "axis",
        "direction",
        "survey_ref",
        "utterance_quote",
        "reason",
        "confidence"
      ],
      "properties": {
        "axis": {
          "enum": [
            "risk_tolerance",
            "principal_preservation",
            "loss_capacity",
            "investment_horizon",
            "product_understanding",
            "purpose"
          ],
          "description": "어느 축에서 모순인지"
        },
        "direction": {
          "enum": [
            "survey_overstates_tolerance",
            "survey_understates_tolerance"
          ],
          "description": "survey_overstates_tolerance = 설문이 실제 발화보다 위험 감수적. 기획서 3절 판결 동향의 '스스로 기재한 투자성향'이 문제되는 방향이며 소비자 보호상 위험한 쪽이다. 어느 방향을 게이트에 걸지는 룰의 결정이다 (P1)"
        },
        "survey_ref": {
          "type": "object",
          "required": [
            "question_id",
            "recorded_answer"
          ],
          "properties": {
            "question_id": {
              "type": "string"
            },
            "question_text": {
              "type": [
                "string",
                "null"
              ]
            },
            "recorded_answer": {
              "type": "string",
              "description": "고객이 설문에 기재한 값. 원문 그대로"
            }
          }
        },
        "utterance_quote": {
          "type": "string",
          "minLength": 1,
          "description": "발화에서 그대로 잘라낸 문장. 요약·재구성 금지 (P4·P6)"
        },
        "item_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "발화가 나온 이해항목. 특정 항목과 무관한 발화면 null"
        },
        "reason": {
          "type": "string",
          "description": "왜 모순인지 1문장"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
