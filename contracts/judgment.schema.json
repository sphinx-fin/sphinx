{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Judgment",
  "description": "F-SCR-001: 항목별 이해도 판정. 근거 없는 판정은 무효 (P4)",
  "type": "object",
  "required": [
    "item_id",
    "grade",
    "confidence",
    "evidence",
    "reason"
  ],
  "properties": {
    "item_id": {
      "type": "string"
    },
    "grade": {
      "enum": [
        "U1",
        "U2",
        "U3",
        "U4"
      ],
      "description": "이해/부분이해/미이해/오해"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "object",
      "required": [
        "utterance_quote",
        "rubric_clause"
      ],
      "properties": {
        "utterance_quote": {
          "type": "string"
        },
        "rubric_clause": {
          "type": "string"
        }
      }
    },
    "reason": {
      "type": "string",
      "description": "판정 사유 1문장"
    },
    "misconception_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "F-DET-001 매칭 시 유형ID (예: M08-TYING)"
    },
    "prompt_version": {
      "type": "string",
      "description": "이 판정을 낸 채점 프롬프트 버전(ai-service scoring.PROMPT_VERSION, 예 F-SCR-001_v2). optional — 이 필드가 생기기 전 레코드는 없다. ❗confidence 의 정의가 프롬프트 버전마다 다르다: v1 은 등급 확신도, v2 는 재현 가능성이다(PR #114). evidence 는 append-only 라 두 정의가 같은 컬럼에 섞이면 감사 시점에 어느 쪽으로 해석할지 판단할 근거가 없어진다 — 그래서 값과 함께 남긴다(결정 10.38 · 이슈 #136)."
    }
  }
}
